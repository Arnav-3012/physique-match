{
  "name": "physique-gap-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "rm -rf public/wasm && cp -r node_modules/@mediapipe/tasks-vision/wasm public/wasm",
    "predev": "npm run wasm",
    "dev": "vite",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "types": "json2ts -i ../../packages/schemas/schema.json -o src/lib/types.gen.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "fast-png": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
