{
  "name": "physique-gap-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "rm -rf public/wasm && cp -r node_modules/@mediapipe/tasks-vision/wasm public/wasm",
    "ort": "rm -rf public/ort && mkdir -p public/ort && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.* public/ort/ && rm -f public/ort/*jsep*",
    "predev": "npm run wasm && npm run ort",
    "dev": "vite",
    "prebuild": "npm run wasm && npm run ort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "types": "json2ts -i ../../packages/schemas/schema.json -o src/lib/types.gen.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "fast-png": "^8.0.0",
    "motion": "^14.9.0",
    "onnxruntime-web": "1.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
