{
  "$defs": {
    "AnalyzeRequest": {
      "additionalProperties": false,
      "description": "Goal and current scans are silhouettes only; the profile is numbers (ADR-003).",
      "properties": {
        "goal": {
          "$ref": "#/$defs/Scan"
        },
        "current": {
          "$ref": "#/$defs/Scan"
        },
        "profile": {
          "$ref": "#/$defs/UserProfile"
        },
        "goal_profile": {
          "$ref": "#/$defs/GoalProfile"
        },
        "definition_scope": {
          "default": "none",
          "enum": [
            "arms_shoulders_legs",
            "full_body",
            "none"
          ],
          "title": "Definition Scope",
          "type": "string"
        },
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefinitionScores"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "goal",
        "current",
        "profile"
      ],
      "title": "AnalyzeRequest",
      "type": "object"
    },
    "AnalyzeResponse": {
      "additionalProperties": false,
      "properties": {
        "gap": {
          "$ref": "#/$defs/GapProfile"
        },
        "body_comp": {
          "$ref": "#/$defs/BodyComp"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "definition_status": {
          "additionalProperties": {
            "$ref": "#/$defs/DefinitionRegionStatus"
          },
          "default": {},
          "propertyNames": {
            "enum": [
              "abs",
              "chest",
              "shoulders",
              "arms",
              "back",
              "legs"
            ]
          },
          "title": "Definition Status",
          "type": "object"
        },
        "waist_g": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waist G"
        }
      },
      "required": [
        "gap",
        "body_comp"
      ],
      "title": "AnalyzeResponse",
      "type": "object"
    },
    "BodyComp": {
      "additionalProperties": false,
      "description": "Energy fields are empty when the user opts out (eating-disorder screen, BMI/BF floors).\n`body_fat` is None when the user's sex is unset: RFM has a sex term and is not guessed\n(ADR-037 Amendment 4); `note` says why. `energy_measured` is False whenever no calorie numbers\nare given (sex unset, under 18, eating-disorder opt-out). `protein` is a per-kg range that\nneeds only body weight, so it still shows when sex is unset (ADR-048 Amendment 2).",
      "properties": {
        "body_fat": {
          "anyOf": [
            {
              "$ref": "#/$defs/BodyFatRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rmr_kcal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmr Kcal"
        },
        "tdee_kcal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tdee Kcal"
        },
        "energy": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnergyTarget"
          },
          "title": "Energy",
          "type": "array"
        },
        "protein": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProteinRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "energy_measured": {
          "default": true,
          "title": "Energy Measured",
          "type": "boolean"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "title": "BodyComp",
      "type": "object"
    },
    "BodyFatRange": {
      "additionalProperties": false,
      "description": "Always a range, never a point estimate (privacy-and-safety.md).",
      "properties": {
        "low": {
          "maximum": 60,
          "minimum": 3,
          "title": "Low",
          "type": "number"
        },
        "high": {
          "maximum": 60,
          "minimum": 3,
          "title": "High",
          "type": "number"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "method",
        "confidence"
      ],
      "title": "BodyFatRange",
      "type": "object"
    },
    "Ceiling": {
      "additionalProperties": false,
      "description": "Reachable frame ceiling, ADR-040: the V-taper index the user's own shoulders allow at a\nleaner waist, from RFM inverted at `BF_ATHLETE_UPPER` and `BF_FLOOR`. Applied in the route\n(it needs the user's sex), like `lats`.",
      "properties": {
        "at_athlete_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Athlete Upper"
        },
        "at_floor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Floor"
        },
        "reachable": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZoneLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "near_floor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ZoneLabel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "zone": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone"
        },
        "zone_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Text"
        },
        "measured": {
          "default": true,
          "title": "Measured",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "Ceiling",
      "type": "object"
    },
    "DefinitionRegionStatus": {
      "additionalProperties": false,
      "description": "Per-region definition status. N/A always has a reason and is never a number (ADR-051).",
      "properties": {
        "status": {
          "enum": [
            "measured",
            "not_measured_covered",
            "not_measured_age_gate",
            "not_measured_goal_covers",
            "not_measured_not_in_demo"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "status"
      ],
      "title": "DefinitionRegionStatus",
      "type": "object"
    },
    "DefinitionScores": {
      "additionalProperties": false,
      "description": "On-device model output; only these two numbers leave the browser (ADR-013). There is deliberately\nno per-region field: the regional heads did not beat the overall score, so a payload, a report or an\nagent prompt built from this cannot say one region is less defined than another (ADR-053 Amendment 6).",
      "properties": {
        "definition": {
          "maximum": 5,
          "minimum": 1,
          "title": "Definition",
          "type": "integer"
        },
        "adiposity": {
          "maximum": 5,
          "minimum": 1,
          "title": "Adiposity",
          "type": "integer"
        },
        "experimental": {
          "default": true,
          "title": "Experimental",
          "type": "boolean"
        }
      },
      "required": [
        "definition",
        "adiposity"
      ],
      "title": "DefinitionScores",
      "type": "object"
    },
    "EnergyTarget": {
      "additionalProperties": false,
      "properties": {
        "goal": {
          "enum": [
            "cut",
            "recomp",
            "bulk",
            "maintain"
          ],
          "title": "Goal",
          "type": "string"
        },
        "kcal_low": {
          "exclusiveMinimum": 0,
          "title": "Kcal Low",
          "type": "number"
        },
        "kcal_high": {
          "exclusiveMinimum": 0,
          "title": "Kcal High",
          "type": "number"
        },
        "protein_g_low": {
          "exclusiveMinimum": 0,
          "title": "Protein G Low",
          "type": "number"
        },
        "protein_g_high": {
          "exclusiveMinimum": 0,
          "title": "Protein G High",
          "type": "number"
        }
      },
      "required": [
        "goal",
        "kcal_low",
        "kcal_high",
        "protein_g_low",
        "protein_g_high"
      ],
      "title": "EnergyTarget",
      "type": "object"
    },
    "GapProfile": {
      "additionalProperties": false,
      "properties": {
        "analyzer": {
          "enum": [
            "geometric",
            "siamese_subtract"
          ],
          "title": "Analyzer",
          "type": "string"
        },
        "regions": {
          "additionalProperties": {
            "$ref": "#/$defs/RegionGap"
          },
          "propertyNames": {
            "enum": [
              "shoulders",
              "chest",
              "upper_back",
              "lats",
              "waist",
              "hips",
              "upper_arm",
              "forearm",
              "thigh",
              "calf"
            ]
          },
          "title": "Regions",
          "type": "object"
        },
        "goal_front_only": {
          "default": false,
          "title": "Goal Front Only",
          "type": "boolean"
        },
        "asymmetry": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "propertyNames": {
                "enum": [
                  "shoulders",
                  "chest",
                  "upper_back",
                  "lats",
                  "waist",
                  "hips",
                  "upper_arm",
                  "forearm",
                  "thigh",
                  "calf"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asymmetry"
        },
        "v_taper": {
          "anyOf": [
            {
              "$ref": "#/$defs/VTaper"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "analyzer",
        "regions"
      ],
      "title": "GapProfile",
      "type": "object"
    },
    "GoalProfile": {
      "additionalProperties": false,
      "description": "What the user says about the goal physique. Never filled from the photo or defaulted to\nthe user's sex (ADR-037 Amendment 3): `lats` needs both sexes set and equal.",
      "properties": {
        "sex": {
          "default": "not_specified",
          "enum": [
            "male",
            "female",
            "not_specified"
          ],
          "title": "Sex",
          "type": "string"
        },
        "not_shown": {
          "default": [],
          "items": {
            "enum": [
              "abs",
              "chest",
              "shoulders",
              "arms",
              "back",
              "legs"
            ],
            "type": "string"
          },
          "title": "Not Shown",
          "type": "array"
        }
      },
      "title": "GoalProfile",
      "type": "object"
    },
    "Keypoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "visibility": {
          "maximum": 1,
          "minimum": 0,
          "title": "Visibility",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "visibility"
      ],
      "title": "Keypoint",
      "type": "object"
    },
    "PlanDay": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "exercises": {
          "items": {
            "$ref": "#/$defs/PlannedExercise"
          },
          "minItems": 1,
          "title": "Exercises",
          "type": "array"
        }
      },
      "required": [
        "label",
        "exercises"
      ],
      "title": "PlanDay",
      "type": "object"
    },
    "PlanRequest": {
      "additionalProperties": false,
      "description": "No scans: the profile, the gap /analyze returned and, without a tape waist, its waist_g.\nThe server recomputes body composition itself and never trusts a client-supplied BodyComp.",
      "properties": {
        "profile": {
          "$ref": "#/$defs/UserProfile"
        },
        "gap": {
          "$ref": "#/$defs/GapProfile"
        },
        "waist_g": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.2,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waist G"
        }
      },
      "required": [
        "profile",
        "gap"
      ],
      "title": "PlanRequest",
      "type": "object"
    },
    "PlanResponse": {
      "additionalProperties": false,
      "properties": {
        "priorities": {
          "items": {
            "enum": [
              "shoulders",
              "chest",
              "upper_back",
              "lats",
              "waist",
              "hips",
              "upper_arm",
              "forearm",
              "thigh",
              "calf"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Priorities",
          "type": "array"
        },
        "days": {
          "items": {
            "items": {
              "$ref": "#/$defs/PlanSlot"
            },
            "type": "array"
          },
          "title": "Days",
          "type": "array"
        },
        "weekly": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weekly",
          "type": "object"
        },
        "shortfalls": {
          "items": {
            "$ref": "#/$defs/PlanShortfall"
          },
          "title": "Shortfalls",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "body_comp": {
          "anyOf": [
            {
              "$ref": "#/$defs/BodyComp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body_comp_note": {
          "default": "",
          "title": "Body Comp Note",
          "type": "string"
        },
        "served_by": {
          "const": "deterministic",
          "title": "Served By",
          "type": "string"
        },
        "retrieval": {
          "enum": [
            "hybrid",
            "bm25"
          ],
          "title": "Retrieval",
          "type": "string"
        }
      },
      "required": [
        "priorities",
        "days",
        "weekly",
        "shortfalls",
        "served_by",
        "retrieval"
      ],
      "title": "PlanResponse",
      "type": "object"
    },
    "PlanShortfall": {
      "additionalProperties": false,
      "description": "A muscle group that ended under its cited weekly floor. Never silent, never lowered.",
      "properties": {
        "group": {
          "title": "Group",
          "type": "string"
        },
        "planned": {
          "minimum": 0,
          "title": "Planned",
          "type": "number"
        },
        "floor": {
          "exclusiveMinimum": 0,
          "title": "Floor",
          "type": "number"
        }
      },
      "required": [
        "group",
        "planned",
        "floor"
      ],
      "title": "PlanShortfall",
      "type": "object"
    },
    "PlanSlot": {
      "additionalProperties": false,
      "properties": {
        "exercise_id": {
          "title": "Exercise Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sets": {
          "maximum": 10,
          "minimum": 1,
          "title": "Sets",
          "type": "integer"
        }
      },
      "required": [
        "exercise_id",
        "name",
        "sets"
      ],
      "title": "PlanSlot",
      "type": "object"
    },
    "PlannedExercise": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "muscle": {
          "title": "Muscle",
          "type": "string"
        },
        "sets": {
          "maximum": 10,
          "minimum": 1,
          "title": "Sets",
          "type": "integer"
        },
        "reps": {
          "title": "Reps",
          "type": "string"
        },
        "cue": {
          "title": "Cue",
          "type": "string"
        },
        "citations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "name",
        "muscle",
        "sets",
        "reps",
        "cue",
        "citations"
      ],
      "title": "PlannedExercise",
      "type": "object"
    },
    "ProteinRange": {
      "additionalProperties": false,
      "description": "Cited typical protein range (kb/nutrition.json, ADR-048). A range, never a point: nothing\ndownstream picks a value inside it unless that is stated as our rule, not a cited number.",
      "properties": {
        "g_per_kg_low": {
          "exclusiveMinimum": 0,
          "title": "G Per Kg Low",
          "type": "number"
        },
        "g_per_kg_high": {
          "exclusiveMinimum": 0,
          "title": "G Per Kg High",
          "type": "number"
        },
        "g_low": {
          "exclusiveMinimum": 0,
          "title": "G Low",
          "type": "integer"
        },
        "g_high": {
          "exclusiveMinimum": 0,
          "title": "G High",
          "type": "integer"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "also_listed": {
          "title": "Also Listed",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "g_per_kg_low",
        "g_per_kg_high",
        "g_low",
        "g_high",
        "unit",
        "label",
        "also_listed",
        "text"
      ],
      "title": "ProteinRange",
      "type": "object"
    },
    "RegionGap": {
      "additionalProperties": false,
      "properties": {
        "delta": {
          "maximum": 1,
          "minimum": -1,
          "title": "Delta",
          "type": "number"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "goal_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal Ratio"
        },
        "current_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Ratio"
        },
        "measured": {
          "default": true,
          "title": "Measured",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "delta",
        "confidence"
      ],
      "title": "RegionGap",
      "type": "object"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "priorities": {
          "items": {
            "enum": [
              "shoulders",
              "chest",
              "upper_back",
              "lats",
              "waist",
              "hips",
              "upper_arm",
              "forearm",
              "thigh",
              "calf"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Priorities",
          "type": "array"
        },
        "gap": {
          "$ref": "#/$defs/GapProfile"
        },
        "body_comp": {
          "$ref": "#/$defs/BodyComp"
        },
        "definition": {
          "anyOf": [
            {
              "$ref": "#/$defs/DefinitionScores"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan": {
          "items": {
            "$ref": "#/$defs/PlanDay"
          },
          "minItems": 1,
          "title": "Plan",
          "type": "array"
        },
        "realism_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realism Note"
        },
        "disclaimer": {
          "title": "Disclaimer",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "priorities",
        "gap",
        "body_comp",
        "plan",
        "disclaimer"
      ],
      "title": "Report",
      "type": "object"
    },
    "Scan": {
      "additionalProperties": false,
      "description": "Front is required: a goal photo may have nothing else (ADR-025). A current scan also needs a\nside view (left, or right mirrored), which AnalyzeRequest checks. Back feeds lat width.",
      "properties": {
        "views": {
          "additionalProperties": {
            "$ref": "#/$defs/ViewData"
          },
          "propertyNames": {
            "enum": [
              "front",
              "left",
              "back",
              "right"
            ]
          },
          "title": "Views",
          "type": "object"
        }
      },
      "required": [
        "views"
      ],
      "title": "Scan",
      "type": "object"
    },
    "UserProfile": {
      "additionalProperties": false,
      "properties": {
        "height_cm": {
          "maximum": 230,
          "minimum": 120,
          "title": "Height Cm",
          "type": "number"
        },
        "weight_kg": {
          "maximum": 300,
          "minimum": 30,
          "title": "Weight Kg",
          "type": "number"
        },
        "age": {
          "maximum": 100,
