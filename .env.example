# Copy to .env (gitignored) and fill in only when the phase says so.
# Never commit .env. Locally the API reads this file; on Cloud Run (ADR-028) the same names are set
# as env vars or Secret Manager mounts. No GCP key file ever goes in this repo.

# --- P0 ------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS (add the Vercel URL once it exists)
WEB_ORIGINS=http://localhost:5173

# --- P0: LLM providers (/health pings both; real use starts in P6) -------
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- P6: agent (OpenAI-compatible, swap providers by env only; ADR-005/017) -
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=
# The LLM writer is off unless this is true (ADR-058); off serves the deterministic plan.
LLM_WRITER_ENABLED=false
LLM_TIMEOUT_S=20

# --- P2: BodyM download needs no key (public S3, --no-sign-request) ------
# --- P5/P7: Upstash Redis for cache + rate limiter when deployed (ADR-028) --
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
